# evoluicv — variáveis de ambiente (ADR-001).
# COMPOSE_PROJECT_NAME e IMAGE_TAG NÃO entram aqui: são gerados pelo deploy-run.sh
# (COMPOSE_PROJECT_NAME = evoluicv | evoluicv-staging; IMAGE_TAG = SHA do commit).
# Valores reais vivem nos secrets do Woodpecker por ambiente (staging_env_file /
# production_env_file), nunca neste arquivo nem no Git.

ANTHROPIC_API_KEY=
# Opcional: modelo/effort por agente (padrão claude-haiku-5-5 / medium; effort: low|medium|high)
AI_ANALYST_MODEL=
AI_ANALYST_EFFORT=
AI_SUGGESTIONS_MODEL=
AI_SUGGESTIONS_EFFORT=
JAVA_OPTS=
# Cotas diárias de análise. Produção: 3 / 200. Staging: 0 (sem limite por IP) / 30.
QUOTA_PER_IP_DAILY=
QUOTA_GLOBAL_DAILY=
BACKEND_MEM_LIMIT=
BACKEND_CPUS=
FRONTEND_MEM_LIMIT=
FRONTEND_CPUS=
