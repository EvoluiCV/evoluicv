# evoluicv — variáveis de ambiente (ADR-001).
# COMPOSE_PROJECT_NAME e IMAGE_TAG NÃO entram aqui: são gerados pelo deploy-run.sh
# (COMPOSE_PROJECT_NAME = evoluicv | evoluicv-staging; IMAGE_TAG = SHA do commit).
# Valores reais vivem nos secrets do Woodpecker por ambiente (staging_env_file /
# production_env_file), nunca neste arquivo nem no Git.

OPENAI_API_KEY=
JAVA_OPTS=
BACKEND_MEM_LIMIT=
BACKEND_CPUS=
FRONTEND_MEM_LIMIT=
FRONTEND_CPUS=
